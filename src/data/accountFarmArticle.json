      "type": "paragraph"
    },
    {
      "alt": "",
      "caption": "",
      "src": "/article/account-farm/image-05.png",
      "type": "image"
    },
    {
      "level": 2,
      "text": "Twitter",
      "type": "heading"
    },
    {
      "content": [
        {
          "text": "Переходим в категории"
